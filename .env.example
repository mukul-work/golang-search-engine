DB_URL=postgres://user:password@localhost:5432/searchengine
# Optional overrides (defaults shown):
# CRAWLER_WORKERS=10
# CRAWLER_TIMEOUT=10s
# CRAWLER_HOST_INTERVAL=1s
# CRAWLER_MAX_PAGE_BYTES=5242880
# LOG_LEVEL=info        # debug, info, warn, error
# LOG_FORMAT=text       # text or json
# CRAWLER_MAX_DEPTH=2          # link hops from a seed; 0 = seeds only
# CRAWLER_MAX_PAGES=500        # most distinct URLs queued, seeds included
# TEST_DB_URL=postgres://user:password@localhost:5432/searchengine_test   # throwaway DB for `go test ./internal/db`
# HTTP_ADDR=127.0.0.1:8080     # server listen address; use :8080 in containers
# CRAWLER_SEEDS_FILE=seeds/corpus.txt   # one URL per line, # comments; replaces CRAWLER_SEEDS
# CRAWLER_SEEDS=https://example.com/    # comma-separated alternative to the file
# CRAWLER_ALLOWED_HOSTS=                # empty = stay on the seed hosts; * = any host